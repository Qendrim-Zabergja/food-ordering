{
  "name": "food-ordering",
  "private": true,
  "version": "0.0.0",
  "description": "Food ordering application - Laravel REST API + React SPA",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "php apps/api/artisan serve",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace web",
    "test:api": "php apps/api/artisan test",
    "migrate": "php apps/api/artisan migrate",
    "seed": "php apps/api/artisan db:seed",
    "fresh": "php apps/api/artisan migrate:fresh --seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
